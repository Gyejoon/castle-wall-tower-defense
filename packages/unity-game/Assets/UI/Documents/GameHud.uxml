<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         engine="UnityEngine.UIElements"
         noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd">
  <ui:Style src="project://database/Assets/UI/Styles/tokens.uss" />
  <ui:Style src="project://database/Assets/UI/Styles/hud.uss" />
  <ui:VisualElement name="game-hud" class="game-hud">
    <ui:VisualElement name="game-hud-top" class="game-hud__top">
      <ui:VisualElement name="hud-energy-panel" class="game-hud__stat game-hud__stat--energy">
        <ui:VisualElement class="game-hud__stat-medal">
          <ui:Label text="⚡" class="game-hud__stat-icon" />
        </ui:VisualElement>
        <ui:Label name="hud-energy" text="46" class="game-hud__stat-value" />
      </ui:VisualElement>
      <ui:VisualElement name="hud-wave-panel" class="game-hud__stat game-hud__stat--wave">
        <ui:Label text="WAVE" class="game-hud__stat-title" />
        <ui:Label name="hud-wave" text="1/20" class="game-hud__stat-value game-hud__stat-value--wave" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="game-hud-top-right" class="game-hud__top-right">
      <ui:Button name="hud-menu" text="II" class="game-hud__round-control game-hud__round-control--pause" />
      <ui:Button name="hud-speed" text="x3 ››" class="game-hud__round-control game-hud__round-control--speed" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
