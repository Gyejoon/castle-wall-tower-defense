<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:gld="GLD.UI.Primitives"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         engine="UnityEngine.UIElements"
         noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd">
  <ui:Style src="project://database/Assets/UI/Styles/tokens.uss" />
  <ui:Style src="project://database/Assets/UI/Styles/primitives.uss" />
  <ui:Style src="project://database/Assets/UI/Styles/overlays.uss" />
  <gld:GLDPanel name="tutorial-overlay" variant="elevated" padding="sm" class="tutorial-overlay">
    <ui:Label name="tutorial-title" text="Summon" />
    <ui:Label name="tutorial-body" text="Use Summon or gacha to draw a tower." />
    <ui:VisualElement name="tutorial-actions" class="tutorial-actions">
      <gld:GLDButton name="tutorial-next" text="Next" variant="secondary" />
      <gld:GLDButton name="tutorial-skip" text="Skip" variant="secondary" />
    </ui:VisualElement>
  </gld:GLDPanel>
</ui:UXML>
