@import url("project://database/Assets/UI/Styles/tokens.uss");
@import url("project://database/Assets/UI/Styles/primitives.uss");
@import url("project://database/Assets/UI/Styles/overlays.uss");

.game-hud {
  flex-grow: 1;
  justify-content: space-between;
  padding: 16px 12px 18px 12px;
}

.game-hud__top {
  flex-direction: row;
  justify-content: space-between;
}

#hud-energy,
#hud-wave,
#hud-hp {
  min-width: 104px;
  min-height: 52px;
  padding: 8px 12px;
  border-width: 0;
  background-color: transparent;
  color: #fff0c4;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  -unity-background-scale-mode: stretch-to-fill;
}

#hud-energy {
  background-image: url("project://database/Assets/Art/Sprites/generated_forest_defense/ui_hud/hud_energy_panel.png");
}

#hud-wave,
#hud-hp {
  background-image: url("project://database/Assets/Art/Sprites/generated_forest_defense/ui_hud/hud_wave_panel.png");
}

.game-hud__status {
  align-self: center;
  padding: 4px 8px;
  border-radius: var(--radius-xs);
  background-color: var(--surface-alpha-panel70);
  color: var(--color-text-secondary);
  font-size: var(--type-caption10-size);
  -unity-text-align: middle-center;
}

.game-hud__bottom {
  align-self: stretch;
}

.game-hud__actions {
  flex-direction: row;
  justify-content: space-between;
}

.game-hud__actions > .gld-btn {
  flex-grow: 1;
  margin-left: 2px;
  margin-right: 2px;
  min-width: 0;
  min-height: 58px;
  border-width: 0;
  background-color: transparent;
  color: #fff0c4;
  -unity-font-style: bold;
  -unity-text-align: lower-center;
  -unity-background-scale-mode: scale-to-fit;
}

#hud-summon {
  background-image: url("project://database/Assets/Art/Sprites/generated_forest_defense/ui_hud/hud_action_move.png");
}

#hud-gacha-t2,
#hud-gacha-t3,
#hud-gacha-t4 {
  background-image: url("project://database/Assets/Art/Sprites/generated_forest_defense/ui_hud/hud_wave_panel.png");
}

#hud-speed {
  background-image: url("project://database/Assets/Art/Sprites/generated_forest_defense/ui_hud/hud_speed_x3_button.png");
}

#hud-menu {
  background-image: url("project://database/Assets/Art/Sprites/generated_forest_defense/ui_hud/hud_action_wall_menu.png");
}
