<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:gld="GLD.UI.Primitives"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         engine="UnityEngine.UIElements"
         noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd">
  <ui:Style src="project://database/Assets/UI/Styles/tokens.uss" />
  <ui:Style src="project://database/Assets/UI/Styles/primitives.uss" />
  <ui:Style src="project://database/Assets/UI/Styles/overlays.uss" />
  <gld:GLDOverlay name="pause-modal" dim="default" class="pause-modal">
    <gld:GLDPanel name="pause-panel" variant="elevated" padding="lg" class="pause-panel">
      <ui:Label name="pause-title" text="설정" />
      <ui:Label name="pause-subtitle" text="전투 속도와 일시정지를 조정합니다." />
      <ui:VisualElement name="pause-speed-row" class="pause-speed-row">
        <gld:GLDButton name="pause-speed-x1" text="x1" variant="secondary" />
        <gld:GLDButton name="pause-speed-x2" text="x2" variant="secondary" />
        <gld:GLDButton name="pause-speed-x3" text="x3" variant="secondary" />
      </ui:VisualElement>
      <gld:GLDButton name="pause-resume" text="재개" variant="primary" />
      <gld:GLDButton name="pause-quit" text="포기" variant="danger" />
    </gld:GLDPanel>
  </gld:GLDOverlay>
</ui:UXML>
