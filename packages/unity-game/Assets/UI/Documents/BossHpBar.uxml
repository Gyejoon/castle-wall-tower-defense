<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:gld="GLD.UI.Primitives"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         engine="UnityEngine.UIElements"
         noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd">
  <ui:Style src="project://database/Assets/UI/Styles/tokens.uss" />
  <ui:Style src="project://database/Assets/UI/Styles/primitives.uss" />
  <ui:Style src="project://database/Assets/UI/Styles/overlays.uss" />
  <gld:GLDPanel name="boss-hp-bar" variant="elevated" padding="sm" class="boss-hp-bar">
    <ui:VisualElement name="boss-hp-header" class="boss-hp-header">
      <ui:Label name="boss-hp-name" text="보스" />
      <ui:Label name="boss-hp-value" text="0/0" />
    </ui:VisualElement>
    <ui:VisualElement name="boss-hp-track" class="boss-hp-track">
      <ui:VisualElement name="boss-hp-fill" class="boss-hp-fill" />
    </ui:VisualElement>
  </gld:GLDPanel>
</ui:UXML>
