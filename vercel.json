{
  "buildCommand": "cd ../.. && cd packages/web-shell && bun --bun vite build && cd ../.. && bun run merge-build",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && bun run scripts/vercel-install.ts",
  "framework": null,
  "redirects": [
    { "source": "/unity", "destination": "/unity/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/unity/Build/WebGL.data.br",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    },
    {
      "source": "/unity/Build/WebGL.framework.js.br",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    },
    {
      "source": "/unity/Build/WebGL.wasm.br",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Content-Encoding", "value": "br" },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
