@import url("project://database/Assets/UI/Styles/tokens.uss");

.game-hud {
  flex-grow: 1;
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: 14px 12px 18px 12px;
}

.game-hud__top {
  position: absolute;
  left: 18px;
  top: 14px;
  flex-direction: row;
  justify-content: flex-start;
  align-items: flex-start;
}

.game-hud__stat {
  height: 48px;
  min-height: 48px;
  border-width: 0;
  border-bottom-width: 0;
  border-radius: var(--radius-md);
  background-color: rgba(0, 0, 0, 0);
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
  padding: 0 10px 0 6px;
  -unity-background-scale-mode: stretch-to-fill;
}

.game-hud__stat--energy {
  width: 86px;
}

.game-hud__stat--wave {
  width: 88px;
  flex-direction: column;
  justify-content: center;
  padding-left: 8px;
  padding-right: 8px;
}

.game-hud__stat-medal {
  width: 34px;
  height: 34px;
  border-width: 0;
  border-radius: var(--radius-pill);
  background-color: rgba(0, 0, 0, 0);
  align-items: center;
  justify-content: center;
  margin-right: 9px;
}

.game-hud__stat-icon {
  color: #fff2a6;
  font-size: 20px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

#hud-energy-panel,
#hud-wave-panel {
  border-width: 0;
  background-color: rgba(0, 0, 0, 0);
  -unity-background-scale-mode: stretch-to-fill;
}

#hud-energy-panel {
  background-image: url("project://database/Assets/Art/Sprites/generated_forest_defense/ui_hud/hud_energy_panel.png");
}

#hud-wave-panel {
  background-image: url("project://database/Assets/Art/Sprites/generated_forest_defense/ui_hud/hud_wave_panel.png");
}

.game-hud__stat-title {
  color: #e8d5a4;
  font-size: var(--type-caption10-size);
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

.game-hud__stat-value {
  color: var(--color-text);
  font-size: 24px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

.game-hud__stat-value--wave {
  font-size: 20px;
  margin-top: 0;
}

.game-hud__top-right {
  position: absolute;
  right: 11px;
  top: 14px;
  flex-direction: column;
  align-items: center;
}

.game-hud__round-control {
  width: 54px;
  min-width: 54px;
  max-width: 54px;
  height: 54px;
  min-height: 54px;
  max-height: 54px;
  margin: 0 0 9px 0;
  padding: 0;
  border-width: 0;
  border-bottom-width: 0;
  border-radius: var(--radius-pill);
  background-color: rgba(0, 0, 0, 0);
  color: #f6e6b8;
  font-size: 18px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  -unity-background-scale-mode: scale-to-fit;
}

#hud-menu {
  background-image: url("project://database/Assets/Art/Sprites/generated_forest_defense/ui_hud/hud_pause_button.png");
}

#hud-speed {
  background-image: url("project://database/Assets/Art/Sprites/generated_forest_defense/ui_hud/hud_speed_x3_button.png");
}
