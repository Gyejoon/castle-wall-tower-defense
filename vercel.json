{
  "buildCommand": "cd ../.. && cd packages/web-shell && bun --bun vite build && cd ../.. && bun run merge-build",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && bun install",
  "framework": null,
  "rewrites": [
    { "source": "/unity", "destination": "/unity/index.html" },
    { "source": "/unity/:path*", "destination": "/unity/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
